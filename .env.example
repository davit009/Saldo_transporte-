# ==========================================
# Saldo Transporte — Variables de entorno
# ==========================================
# Copia este archivo como .env.local y completa los valores.
#
# Este proyecto usa el MISMO proyecto de Supabase que Migrante$
# (no hay slots libres para crear uno nuevo). Usa las mismas
# credenciales que ya tienes configuradas ahí:
# Supabase Dashboard -> Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL pública de la app (para redirects de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
